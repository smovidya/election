---
import "../styles/global.css";
import "../styles/fonts.css";
import { event } from "@repo/constants";
import { APP_ENV } from "astro:env/client";
import StagingBanner from "../components/StagingBanner.astro";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/assets/icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{event.short_name.th}</title>
    <meta name="description" content={event.description.th} />
    <meta property="og:title" content={event.short_name.th} />
    <meta property="og:description" content={event.description.th} />
    <script>
      if (
        navigator.userAgent.includes("Line") ||
        navigator.userAgent.includes("Instagram") ||
        navigator.userAgent.includes("FBAV")
      ) {
        const nobuiltinbrowser = document.querySelector(
          "[data-nobuiltinbrowser]",
        );
        const main = document.querySelector("main.contents");
        if (nobuiltinbrowser && main) {
          nobuiltinbrowser.classList.remove("hidden");
          main.classList.add("hidden");
        }

        if (navigator.userAgent.includes("Line")) {
          const url = new URL(window.location.href);
          url.searchParams.set("openExternalBrowser", "1");
          window.location.href = url.toString();
        }
      }
    </script>
  </head>

  <noscript>
    <p class="text-center mt-4">
      โปรดเปิดใช้งาน JavaScript เพื่อใช้งานเว็บไซต์นี้อย่างเต็มประสิทธิภาพ
    </p>
  </noscript>

  <body class="max-w-md mx-auto">
    {APP_ENV === "staging" && <StagingBanner />}
    <main class="contents">
      <slot />
    </main>
    <div data-nobuiltinbrowser class="text-center mt-4 hidden p-5">
      <h1 class="text-xl font-bold mb-2">
        โปรดเปิดในเบราว์เซอร์ภายนอกเพื่อใช้งานเว็บไซต์นี้อย่างเต็มประสิทธิภาพ
      </h1>
      <p class="text-lg mt-2">
        เว็บไซต์นี้ไม่สามารถใช้งานใน Line/Instagram/Facebook in-app browser ได้
        กรุณาเปิดลิงก์นี้ในเบราว์เซอร์ภายนอก เช่น Chrome, Safari, หรือ Firefox
        เพื่อให้เว็บไซต์ทำงานได้อย่างถูกต้อง
      </p>
    </div>
  </body>
</html>
